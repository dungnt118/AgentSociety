# ==============================================================================
# UNIVERSAL ISSUE RESOLVER — CẤU HÌNH MÔI TRƯỜNG KIỂM THỬ LOCAL DOCKER DESKTOP
# File này được tự động bảo vệ trong .gitignore (tuyệt đối không commit secret).
# Áp dụng tổng quát cho MỌI Business Domain & MỌI Tech Stack.
# ==============================================================================

# 1. Định danh Dự án & Phân hệ Nghiệp vụ
APP_NAME=
BUSINESS_DOMAIN=

# 2. Điểm truy cập Ứng dụng chạy trên Local Docker Desktop
FRONTEND_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
HEALTHCHECK_URL=http://localhost:8080/health

# 3. Cấu hình Cụm Container Local Docker Desktop
DOCKER_COMPOSE_FILE=docker-compose.yml
DOCKER_PROJECT_NAME=
DOCKER_BUILD_DEPLOY_CMD=docker compose up -d --build
DOCKER_STATUS_CMD=docker compose ps
CONTAINER_LOG_CMD=docker compose logs --tail=150

# 4. Kiểm chứng Hậu trường (Database / Cache / Message Queue)
DATABASE_URL=
DB_VERIFY_CMD=
QUEUE_OR_CACHE_VERIFY_CMD=

# 5. Tài khoản Kiểm thử (Dùng cho kịch bản tái hiện & Human-Like Test)
PRIMARY_USERNAME=
PRIMARY_PASSWORD=
PRIMARY_API_TOKEN=

SECONDARY_USERNAME=
SECONDARY_PASSWORD=
SECONDARY_API_TOKEN=

# 6. Tùy chọn Trình duyệt & Hồi quy
BROWSER_VIEWPORT=1440x900
MOBILE_VIEWPORT=390x844
PROJECT_REGRESSION_TEST_CMD=
