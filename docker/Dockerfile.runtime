# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        libgomp1 \
        procps \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /uvx /usr/local/bin/

WORKDIR /app

ENV UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./
COPY packages/agentsociety2/pyproject.toml ./packages/agentsociety2/pyproject.toml

RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-dev --no-emit-package agentsociety2 \
        --format requirements-txt -o /tmp/reqs.txt \
    && ( \
        uv pip install --system --no-config --no-deps --require-hashes -r /tmp/reqs.txt \
        || ( \
            sed -i '/^--index-url/d; /^--extra-index-url/d' /tmp/reqs.txt \
            && uv pip install --system --no-config --index-url https://pypi.org/simple --no-deps --require-hashes -r /tmp/reqs.txt \
        ) \
    ) \
    && uv pip check --system \
    && rm -f /tmp/reqs.txt

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libatomic1 \
    && python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY README.md LICENSE ./
COPY packages/agentsociety2/ ./packages/agentsociety2/
COPY examples/v2/daily_mobility/ ./examples/v2/daily_mobility/
COPY docker/run_scenarios.sh docker/run_prisoners_dilemma.py ./docker/

RUN sed -i 's/\r$//' /app/docker/run_scenarios.sh \
    && chmod +x /app/docker/run_scenarios.sh

RUN --mount=type=cache,target=/root/.cache/uv \
    UV_DEFAULT_INDEX=https://pypi.org/simple uv pip install --system --no-config --index-url https://pypi.org/simple --no-deps -e ./packages/agentsociety2 \
    && python -c "import agentsociety2, yaml, shapely, fastapi, uvicorn, ray; print('RUNTIME_IMPORTS_OK')"
