# =============================================================================
# AGENTSOCIETY2 ENVIRONMENT TEMPLATE (portainer.env.example)
# HƯỚNG DẪN:
#   1. Copy tệp này thành `portainer.env` (đã được .gitignore chặn commit).
#   2. Điền đầy đủ các API Key, DOCKERHUB_TOKEN và PORTAINER_ACCESS_TOKEN.
#   3. Chạy `build_and_deploy.bat` hoặc `.\build_and_deploy.ps1`.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. CỔNG DỊCH VỤ (SERVICE PORTS)
# ─────────────────────────────────────────────────────────────────────────────
AGENTSOCIETY_WEB_PORT=5173
AGENTSOCIETY_API_PORT=8001
AGENTSOCIETY_MOBILITY_PORT=8765
TIMEZONE=Asia/Ho_Chi_Minh

# ─────────────────────────────────────────────────────────────────────────────
# 2. CẤU HÌNH LLM & EMBEDDING
# ─────────────────────────────────────────────────────────────────────────────
AGENTSOCIETY_LLM_API_KEY=your_api_key
AGENTSOCIETY_LLM_API_BASE=https://api.openai.com/v1
AGENTSOCIETY_LLM_MODEL=gpt-6-luna

AGENTSOCIETY_CODER_LLM_API_KEY=
AGENTSOCIETY_CODER_LLM_API_BASE=
AGENTSOCIETY_CODER_LLM_MODEL=

AGENTSOCIETY_LLM_THINKING=off
AGENTSOCIETY_CODER_LLM_THINKING=off
AGENTSOCIETY_LLM_API_TYPE=openai

AGENTSOCIETY_EMBEDDING_API_KEY=
AGENTSOCIETY_EMBEDDING_API_BASE=https://api.openai.com/v1
AGENTSOCIETY_EMBEDDING_MODEL=text-embedding-3-large
AGENTSOCIETY_EMBEDDING_DIMS=1024

# ─────────────────────────────────────────────────────────────────────────────
# 3. CẤU HÌNH BACKEND & URBAN SIMULATION
# ─────────────────────────────────────────────────────────────────────────────
AGENTSOCIETY_HOME_DIR=/data/agentsociety_data
WORKSPACE_PATH=/workspace

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
BACKEND_TRUSTED_HOSTS=backend,localhost,127.0.0.1
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001
BACKEND_TOKEN=

URBAN_SIM_FERNET_KEY=
DASHBOARD_USD_TO_VND=25500
MEM0_TELEMETRY=False
ANONYMIZED_TELEMETRY=False
URBAN_SIM_ALLOW_LOCAL_URLS=1

# ─────────────────────────────────────────────────────────────────────────────
# 4. DOCKERHUB REPOSITORY & IMAGES (DEPLOY-ONLY CHO TOKEN)
# ─────────────────────────────────────────────────────────────────────────────
DOCKER_IMAGE_REPO=dungnt118/freepbx
AGENTSOCIETY_RUNTIME_TAG=agentsociety2-runtime
AGENTSOCIETY_GATEWAY_TAG=agentsociety2-gateway
AGENTSOCIETY_RUNTIME_IMAGE=dungnt118/freepbx:agentsociety2-runtime
AGENTSOCIETY_GATEWAY_IMAGE=dungnt118/freepbx:agentsociety2-gateway
DOCKERHUB_USERNAME=dungnt118
DOCKERHUB_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 5. PORTAINER PRODUCTION DEPLOYMENT API (DEPLOY-ONLY)
# ─────────────────────────────────────────────────────────────────────────────
PORTAINER_URL=https://portainer.demego.vn
PORTAINER_ACCESS_TOKEN=
PORTAINER_ENDPOINT_ID=3
# Điền ID của Stack AgentSociety2 trên Portainer để tự động redeploy qua API:
PORTAINER_STACK_ID=
PORTAINER_STACK_NAME=agentsociety2
